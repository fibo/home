{
  "effortLevel": "medium",
  "prefersReducedMotion": true,
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "sh $HOME/.claude/statusline.sh"
  },
  "attribution": {
      "commit": "",
      "pr": ""
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "read": {
      "deny": [
        "**/.env*"
      ]
    },
    "allow": [
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Edit",
      "Write",
      "Bash(rm *)",
      "Bash(git branch -a)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git merge --ff-only)",
      "Bash(git rebase *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Bash(git worktree remove *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm outdated)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(make *)",
      "Bash(task *)",
      "Bash(rumdl check *)",
      "Bash($HOME/.claude/skills/task/scripts/*.sh)",
      "WebSearch"
    ],
    "deny": [
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push --force-with-lease)"
    ]
  }
}
