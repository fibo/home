{
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "theme": "dark",
  "permissions": {
    "defaultMode": "auto",
    "read": {
      "deny": [
        "**/.env*"
      ]
    },
    "allow": [
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Edit",
      "Write",
      "Bash(rm *)",
      "Bash(git branch -a)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git rebase *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Bash(git worktree remove *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm outdated)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(make *)",
      "Bash(task *)",
      "Bash(rumdl check *)",
      "Bash($HOME/.claude/skills/git-worktree/scripts/*.sh)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git merge --ff-only *)",
      "Bash(git push)",
      "Bash(git push --force-with-lease)"
    ]
  }
}
