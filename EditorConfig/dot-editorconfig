# http://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{package,package-lock}.json]
indent_style = space
indent_size = 2

[*.{toml,yaml,yml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 4

[{.bashrc,.bash_profile,.profile,.zshrc,.zshenv,.zprofile,.zlogin,.zlogout}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
